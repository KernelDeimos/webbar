#!/bin/sh
# webbar cpu module — busy percentage over a short sample of /proc/stat.
sample() { awk '/^cpu /{idle=$5+$6; tot=0; for(i=2;i<=NF;i++) tot+=$i; print idle, tot}' /proc/stat; }
set -- $(sample); i1=$1; t1=$2
sleep 0.3
set -- $(sample); i2=$1; t2=$2
awk -v i1="$i1" -v t1="$t1" -v i2="$i2" -v t2="$t2" \
  'BEGIN{ dt=t2-t1; di=i2-i1; if(dt<=0){print "0%"; exit} printf "%d%%", (1-di/dt)*100 }'
